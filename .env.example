# Copy to .env and fill in. .env is git-ignored — keys never enter the repo.

# Inference route (decision 2026-11-19): cloud API first.
# Any OpenAI-compatible endpoint works. ⚠️ Cloud = student data leaves the
# device: a signed DPA + cross-border transfer review (HK-plan §3) is REQUIRED
# before any real student data touches this route. Local (Ollama) stays the
# compliance-upgrade path.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
VISION_MODEL=gpt-4o-mini
TEXT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small   # required in online mode — grounding embeds every case
# Some endpoints (e.g. OpenCode Go) expose chat but no /embeddings.
# Set EMBEDDING_MODE=local to run grounding on the deterministic local
# embedding; such runs are labelled openai-compatible+local-hash and must
# not be reported as a full online pipeline.
EMBEDDING_MODE=api
# Extra HTTP headers for gateways that require them (JSON object), e.g.
# LLM_EXTRA_HEADERS={"x-opencode-session":"<session-id>"}
LLM_EXTRA_HEADERS={}

# Local fallback (compliance upgrade path — data never leaves the machine):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# VISION_MODEL=qwen2.5vl:7b
# TEXT_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=bge-m3:567m

# Pipeline knobs
GROUNDING_THRESHOLD=0.42      # below this a knowledge point is reported unmapped, never guessed
CONFIDENCE_REVIEW=0.60        # below this the diagnosis is flagged for a teacher's check
MAX_PRACTICE_PER_DAY=3

# Run without any API key (rule-based baseline, clearly labelled as such)
PATHFINDER_OFFLINE=0

# Storage
DB_PATH=data/pathfinder.db
