<Slide style={{ width: 1280, height: 720, padding: 60, background: '#0E1A2B', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'column', gap: 10, marginBottom: 18 }}>
        <Text style={{ fontSize: 34, color: '#FFFFFF', fontWeight: 'bold' }}>让一对一诊断成为日常</Text>
        <Box style={{ width: 72, height: 2, background: '#F5A623' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 30, flex: 1 }}>
        <Box style={{ width: 560, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 88, color: '#F5A623', fontWeight: 'bold', lineHeight: 1 }}>14 天</Text>
                <Text style={{ fontSize: 22, color: '#E8EDF4', fontWeight: 'bold' }}>重复错误率 · 核心量化指标</Text>
                <Text style={{ fontSize: 15, color: '#93A1B5', lineHeight: 1.5, marginTop: 8 }}>
                    同一知识点在 14 天内再次作为新错题出现的比例。已实现于 store.repeat_error_rate 并通过单元测试。
                </Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 14 }}>
                {[
                    ['globe', '社会价值 · SDG 4', '把稀缺的一对一诊断变成每个学生的日常能力'],
                    ['briefcase', '业务价值 · SaaS', '班级热力图成为教研数据资产，个性化路径提升留存'],
                    ['chart-line', '辅助指标', '教师诊断耗时 · 路径完成率 · 学生自评信心'],
                ].map((it, idx) => (
                    <Box key={idx} style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                        <FAIcon name={it[0]} style={{ fill: '#F5A623', width: 26, height: 26 }} />
                        <Box>
                            <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>{it[1]}</Text>
                            <Text style={{ fontSize: 14, color: '#93A1B5', lineHeight: 1.45 }}>{it[2]}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>
        <Box style={{ flex: 1, position: 'relative', borderRadius: 10, overflow: 'hidden' }}>
            <Image src="assets/path.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
            <Box style={{ position: 'absolute', bottom: 20, left: 20, background: 'rgba(14,26,43,0.78)', borderRadius: 8, padding: 14 }}>
                <Text style={{ fontSize: 16, color: '#F5A623', fontWeight: 'bold' }}>Day 1 · 3 · 7</Text>
                <Text style={{ fontSize: 14, color: '#E8EDF4' }}>间隔复习路径，每天 ≤ 3 题</Text>
            </Box>
        </Box>
    </Box>
</Slide>
