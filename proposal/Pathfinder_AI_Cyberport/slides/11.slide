                <Box key={idx} style={{ flexDirection: 'row', gap: 14, paddingTop: 9, paddingBottom: 9, borderBottom: '1px solid #1B2B40' }}>
                    <Text style={{ fontSize: 16, color: '#F5A623', fontWeight: 'bold', width: 92 }}>{r[0]}</Text>
                    <Text style={{ fontSize: 15, color: '#E8EDF4', flex: 1, lineHeight: 1.45 }}>{r[1]}</Text>
                </Box>
            ))}
        </Box>
        <Box style={{ width: 440, background: '#162434', borderRadius: 10, padding: 24, flexDirection: 'column', gap: 16 }}>
            <Text style={{ fontSize: 18, color: '#F5A623', fontWeight: 'bold' }}>技术佐证材料</Text>
            {[
                ['file-text', 'traces/', '3 条运行 + 2 份评估报告'],
                ['check-circle', 'tests/test_pure.py', '23 项离线测试，零 API 消耗'],
                ['file', 'samples/', '7 个带教师标注的样本'],
