<Slide style={{ width: 1280, height: 720, padding: 60, background: '#0E1A2B', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'column', gap: 10, marginBottom: 22 }}>
        <Text style={{ fontSize: 34, color: '#FFFFFF', fontWeight: 'bold' }}>案例：错在去括号，不是算错答案</Text>
        <Box style={{ width: 72, height: 2, background: '#F5A623' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 30, flex: 1 }}>
        <Box style={{ width: 560, flexDirection: 'column', gap: 14 }}>
            <Text style={{ fontSize: 16, color: '#F5A623', fontWeight: 'bold' }}>学生原始作答 · 2(x+3) = 4x−6</Text>
            {[
                ['step 1', '2x + 3 = 4x − 6', true],
                ['step 2', '3 = 2x − 6', false],
                ['step 3', 'x = 4.5', false],
            ].map((s, idx) => (
                <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: s[2] ? '#3A2A12' : '#1B2B40', borderRadius: 8, padding: 18, border: s[2] ? '1px solid #F5A623' : '1px solid #1B2B40' }}>
                    <Text style={{ fontSize: 15, color: s[2] ? '#F5A623' : '#93A1B5', width: 60 }}>{s[0]}</Text>
                    <Text style={{ fontSize: 22, color: s[2] ? '#FFFFFF' : '#B9C6D6', fontWeight: s[2] ? 'bold' : 'normal' }}>{s[1]}</Text>
                    {s[2] && <FAIcon name="exclamation-circle" style={{ fill: '#F5A623', width: 24, height: 24 }} />}
                </Box>
            ))}
            <Text style={{ fontSize: 16, color: '#93A1B5', lineHeight: 1.5, marginTop: 6 }}>
                分配律没有把 2 乘进括号内的 3 —— 断点在第一步，最终结果只是它的后果。
            </Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
            <Text style={{ fontSize: 16, color: '#F5A623', fontWeight: 'bold' }}>系统结构化诊断输出</Text>
            <Box style={{ background: '#162434', borderRadius: 10, padding: 20, flexDirection: 'column', gap: 12, flex: 1 }}>
                {[
                    ['断点步骤', '2x + 3 = 4x − 6'],
                    ['错误类型', 'conceptual（概念性）'],
                    ['知识点', 'ALG-7.3 去括号与分配律'],
                    ['置信度', '0.9 · 高于复核阈值 0.60'],
                    ['分级练习', 'easy → medium → applied'],
                    ['复习排程', 'day 1 / 3 / 7'],
                ].map((r, idx) => (
                    <Box key={idx} style={{ flexDirection: 'row', justifyContent: 'space-between', paddingBottom: 10, borderBottom: '1px solid #1B2B40' }}>
                        <Text style={{ fontSize: 16, color: '#93A1B5' }}>{r[0]}</Text>
                        <Text style={{ fontSize: 17, color: idx === 0 ? '#F5A623' : '#E8EDF4', fontWeight: idx === 0 ? 'bold' : 'normal' }}>{r[1]}</Text>
                    </Box>
                ))}
            </Box>
        </Box>
    </Box>
</Slide>
