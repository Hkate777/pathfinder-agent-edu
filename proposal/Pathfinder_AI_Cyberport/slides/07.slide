<Slide style={{ width: 1280, height: 720, padding: 60, background: '#0E1A2B', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'column', gap: 10, marginBottom: 20 }}>
        <Text style={{ fontSize: 34, color: '#FFFFFF', fontWeight: 'bold' }}>诚实，是第一创新</Text>
        <Box style={{ width: 72, height: 2, background: '#F5A623' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}>
        <Box style={{ width: 700, flexDirection: 'column', gap: 12 }}>
            {[
                ['01', '断点级诊断', '输出引用具体出错步骤，让错题变成可计算的数据'],
                ['02', 'Grounded 出题', '练习来自课程知识图谱，可教、可批改、不超纲'],
                ['03', '诚实失败 Abstention', '读不清/未映射/低置信各有专属状态，绝不编造'],
                ['04', '间隔复习排程', 'day 1/3/7 + 每天限量，把教育心理学固化为算法'],
                ['05', '可审计纵向画像', 'append-only + 重算画像，让重复错误率可被验证'],
            ].map((it, idx) => (
                <Box key={idx} style={{ flexDirection: 'row', gap: 16, alignItems: 'center', paddingTop: 10, paddingBottom: 10, borderBottom: '1px solid #1B2B40' }}>
                    <Text style={{ fontSize: 20, color: '#F5A623', fontWeight: 'bold', width: 40 }}>{it[0]}</Text>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold', width: 180 }}>{it[1]}</Text>
                    <Text style={{ fontSize: 15, color: '#B9C6D6', flex: 1, lineHeight: 1.4 }}>{it[2]}</Text>
                </Box>
            ))}
        </Box>
        <Box style={{ flex: 1, background: '#162434', borderRadius: 10, padding: 22, flexDirection: 'column', gap: 16 }}>
            <Text style={{ fontSize: 18, color: '#F5A623', fontWeight: 'bold' }}>安全底座</Text>
            {[
                ['shield', '闭集错误分类', '非法类型强制归一并记日志'],
                ['lock', '提供者标注', '规则基线输出永不冒充模型诊断'],
                ['history', '只增不改', '错题记录 append-only，全程可追溯'],
            ].map((it, idx) => (
                <Box key={idx} style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <FAIcon name={it[0]} style={{ fill: '#F5A623', width: 24, height: 24 }} />
                    <Box style={{ flexDirection: 'column', gap: 4 }}>
                        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>{it[1]}</Text>
                        <Text style={{ fontSize: 14, color: '#93A1B5', lineHeight: 1.4 }}>{it[2]}</Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>
</Slide>
