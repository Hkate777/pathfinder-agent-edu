<Slide style={{ width: 1280, height: 720, padding: 60, background: '#0E1A2B', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'column', gap: 10, marginBottom: 22 }}>
        <Text style={{ fontSize: 34, color: '#FFFFFF', fontWeight: 'bold' }}>从一张照片到一条复习路径</Text>
        <Box style={{ width: 72, height: 2, background: '#F5A623' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'stretch', height: 210, marginBottom: 24 }}>
        {[
            ['1', '解析', '视觉模型转录题目与学生步骤，保留原始记号'],
            ['2', '诊断', '定位第一个出错步骤，输出闭集错误类型'],
            ['3', '检索', '与课程知识图谱比对，低于阈值即 unmapped'],
            ['4', '出题', '从知识库取回讲解与 3 道分级练习'],
            ['5', '排程', '按风险排序，分布到 day 1 / 3 / 7'],
            ['6', '存储', '错题 append-only，画像每次重算'],
        ].map((s, idx) => (
            <Box key={idx} style={{ flex: 1, flexDirection: 'column', background: '#1B2B40', borderRadius: 8, padding: 16, gap: 10 }}>
                <Text style={{ fontSize: 26, color: '#F5A623', fontWeight: 'bold' }}>{s[0]}</Text>
                <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>{s[1]}</Text>
                <Text style={{ fontSize: 13, color: '#B9C6D6', lineHeight: 1.45 }}>{s[2]}</Text>
            </Box>
        ))}
    </Box>
    <Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 16, color: '#F5A623', fontWeight: 'bold' }}>两道诚实闸门</Text>
            <Box style={{ background: '#2A1E12', borderRadius: 8, padding: 16 }}>
                <Text style={{ fontSize: 18, color: '#F5A623', fontWeight: 'bold' }}>读不清 → 重拍请求</Text>
                <Text style={{ fontSize: 15, color: '#B9C6D6', lineHeight: 1.45, marginTop: 4 }}>非 ok 状态直接短路，绝不猜测题目</Text>
            </Box>
            <Box style={{ background: '#2A1E12', borderRadius: 8, padding: 16 }}>
                <Text style={{ fontSize: 18, color: '#F5A623', fontWeight: 'bold' }}>匹配不到 → unmapped</Text>
                <Text style={{ fontSize: 15, color: '#B9C6D6', lineHeight: 1.45, marginTop: 4 }}>相似度低于阈值即如实标记，不 guessed</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, background: '#0A1421', borderRadius: 8, padding: 18, flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 16, color: '#F5A623', fontWeight: 'bold' }}>真实诊断输出（节选）</Text>
            <Text style={{ fontSize: 14, color: '#E8EDF4', lineHeight: 1.7 }}>
                broken_step: 2x+3 = 4x−6<br />
                error_type: <span style={{ color: '#F5A623' }}>conceptual</span><br />
                knowledge_point: ALG-7.3<br />
                confidence: 0.9<br />
                grounding_score: 0.8621
            </Text>
        </Box>
    </Box>
</Slide>
